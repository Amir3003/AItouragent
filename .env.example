# ── Zari Travel Production Environment Configuration ──────────────────────────

# Base Domain and Host Configuration
DOMAIN=zaritravel.com
BASE_URL=https://zaritravel.com
PORT=8000
ENVIRONMENT=production

# AI LLM Provider Configuration (OpenRouter / Google Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Amadeus Global Distribution System (Optional Live Charter Flights)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Concierge & WhatsApp Dispatch Integration
CONCIERGE_PHONE=77019998877
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token

# SQLite & Security Parameters
DATABASE_URL=sqlite:///zari_travel.db
ALLOWED_ORIGINS=https://zaritravel.com,https://www.zaritravel.com

